# syntax=docker/dockerfile:1
#
# Builds the standalone GeoCore Admin Portal — a separate image/deployment
# from the main platform's Dockerfile, running backend/app/main_admin.py
# instead of backend/app/main.py. See that file's docstring for why this
# is a genuinely separate process rather than a route inside the main one.
#
# Deploy this as its OWN Railway service (or any other host), pointed at
# the SAME repo, using this Dockerfile specifically (Railway: Settings ->
# Build -> Dockerfile Path -> "Dockerfile.admin"). It needs the exact same
# DATABASE_URL (or DB_HOST/DB_USER/etc, whichever this app uses) as the
# main platform, since both read/write the same schema — but does NOT
# need ANTHROPIC/GEMINI keys, Resend keys, or anything customer-facing-
# feature-specific; it only needs whatever auth/DB settings core/config.py
# requires plus LICENSE_PRIVATE_KEY (license issuance lives here now).

FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json ./
RUN npm install
COPY frontend ./
RUN npm run build

FROM python:3.11-slim AS backend
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend ./backend
# The full multi-entry Vite build output is copied wholesale (same as the
# main Dockerfile) -- main_admin.py's static serving only ever falls back
# to admin.html regardless of path, so the other bundles' files simply
# sit unused alongside it. No separate frontend build needed.
COPY --from=frontend-build /app/frontend/dist ./backend/app/static

EXPOSE 8000
# No `alembic upgrade head` here on purpose -- see main_admin.py's
# docstring for why only the main platform's deployment owns migrations.
CMD ["sh", "-c", "uvicorn backend.app.main_admin:app --host 0.0.0.0 --port ${PORT:-8000}"]
