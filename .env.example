APP_NAME=GeoCore
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Supabase Postgres — use the "Session pooler" host (port 5432), not the
# direct connection string. The direct connection is IPv6-only, which
# Railway (and most PaaS containers) can't reach. The Session pooler is
# IPv4-friendly and, unlike the Transaction pooler (6543), supports full
# session-level Postgres features, which this app's SQLAlchemy connection
# pool relies on.
# Get these from: Supabase dashboard -> Project Settings -> Database -> Connection string -> Session pooler

# PREFERRED: set these instead of DATABASE_URL below. The app assembles the
# connection string itself and percent-encodes the password automatically,
# so special characters like @ # / % in your DB password can't corrupt the
# host/port (this bit us before: an unescaped "@" in the password turned
# the host into "@aws-0-...pooler.supabase.com" and caused a confusing
# "Connection refused" error at startup).
DB_USER=postgres.kutglcofjmwsfwfzxbed
DB_PASSWORD=your-new-rotated-password
DB_HOST=aws-0-eu-north-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# LEGACY FALLBACK: only used if DB_USER/DB_PASSWORD/DB_HOST above aren't set.
# If you use this instead, you must percent-encode special characters in the
# password yourself (e.g. "@" -> "%40", "/" -> "%2F", "#" -> "%23").
# Format: postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.kutglcofjmwsfwfzxbed:your-new-rotated-password@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require

SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GeoAI — optional. Reports work fine without this; the "Generate with
# GeoAI insights" option just won't appear if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Licensing — see docs/CHANGES_LICENSING_AND_ADMIN_PORTAL.md before
# touching any of these.
#
# LICENSE_PUBLIC_KEY: safe to set on every deployment (cloud AND on-prem).
# Generate once with: python backend/scripts/generate_license_keypair.py
LICENSE_PUBLIC_KEY=
#
# LICENSE_PRIVATE_KEY: set this ONLY on your own team's Admin Portal
# instance. NEVER set this on a customer deployment (cloud or on-prem) —
# without it, the Admin Portal's license-issuing endpoint safely 503s
# instead of doing anything.
LICENSE_PRIVATE_KEY=
#
# "cloud" (multi-tenant, vendor-operated) or "on_prem" (customer-operated,
# possibly air-gapped). Informational/diagnostic today.
DEPLOYMENT_MODE=cloud

# Resend — optional, used only by the Admin Portal to auto-email newly
# issued license keys. Without this, issuing a license still works, you
# just copy/send the key manually instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=licensing@yourdomain.com
