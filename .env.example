APP_NAME=GeoCore
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Supabase Postgres — use the "Session pooler" host (port 5432), not the
# direct connection string. The direct connection is IPv6-only, which
# Railway (and most PaaS containers) can't reach. The Session pooler is
# IPv4-friendly and, unlike the Transaction pooler (6543), supports full
# session-level Postgres features, which this app's SQLAlchemy connection
# pool relies on.
# Get these from: Supabase dashboard -> Project Settings -> Database -> Connection string -> Session pooler

# PREFERRED: set these instead of DATABASE_URL below. The app assembles the
# connection string itself and percent-encodes the password automatically,
# so special characters like @ # / % in your DB password can't corrupt the
# host/port (this bit us before: an unescaped "@" in the password turned
# the host into "@aws-0-...pooler.supabase.com" and caused a confusing
# "Connection refused" error at startup).
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# LEGACY FALLBACK: only used if DB_USER/DB_PASSWORD/DB_HOST above aren't set.
# If you use this instead, you must percent-encode special characters in the
# password yourself (e.g. "@" -> "%40", "/" -> "%2F", "#" -> "%23").
# Format: postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
